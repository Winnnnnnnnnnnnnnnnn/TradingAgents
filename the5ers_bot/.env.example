# Copy to .env and fill in:  cp .env.example .env
# NEVER commit the resulting .env file.

# --- MetaApi credentials --------------------------------------------------- #
METAAPI_TOKEN=your-metaapi-token
METAAPI_ACCOUNT_ID=
METAAPI_PLATFORM=mt5
# METAAPI_REGION=new-york

# --- Raw MT5 credentials (only if METAAPI_ACCOUNT_ID is empty) ------------- #
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=The5ers-Live
MT5_MAGIC=520052

# --- Instruments / strategy ------------------------------------------------ #
TRADING_SYMBOLS=BTCUSD,ETHUSD
SYMBOL_SUFFIX=
STRATEGY_TIMEFRAME=15m
CANDLE_LIMIT=200
POLL_INTERVAL_SECONDS=60

EMA_FAST=21
EMA_SLOW=55
RSI_PERIOD=14
RSI_LONG_MIN=52
RSI_SHORT_MAX=48
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
REWARD_RISK=3.0
# Strict minimum 1:3 - any smaller value is clamped up to 1:3 at runtime.
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=2

# --- Triple-Lock kill switch ----------------------------------------------- #
DAILY_PROFIT_TARGET=60
DAILY_MAX_LOSS=100
DAILY_RESET_TZ=UTC
KILL_SWITCH_AUTO_CLOSE=true
KILL_SWITCH_STATE_FILE=.state/kill_switch_state.json

# --- Safety switches -------------------------------------------------------- #
DRY_RUN=true
PAPER_MODE=false
LOG_LEVEL=INFO

# --- Paper mode only -------------------------------------------------------- #
PAPER_START_BALANCE=5000
PAPER_BASE_PRICES=BTCUSD:65000,ETHUSD:3200
